# One free/trial key for open-weight models. Cerebras is used if both are set.
# Without either, RoadCheck uses its keyword reader and template answers.
# https://cloud.cerebras.ai — runs qwen-3.8-27b
CEREBRAS_API_KEY=
# https://console.groq.com — runs Llama 3.3 70B / 3.1 8B
GROQ_API_KEY=

# Optional overrides (open-weight models only; Claude/GPT/Gemini/Grok are refused)
# ROADCHECK_MODEL=
# ROADCHECK_FAST_MODEL=

# Force the keyword reader even with a key
# ROADCHECK_REHEARSAL=1

# Hosting
# Where roadcheck.json lives (point at a persistent volume)
# ROADCHECK_DATA_DIR=/data
# File the starter reports on startup if the store is empty
# ROADCHECK_SEED_ON_START=1
# Keep the starter reports recent on a hosted copy (only theirs; others are untouched)
# ROADCHECK_KEEP_STARTER_FRESH=1
# Enables POST /api/seed (Authorization: Bearer <token>) to refresh starter reports
# SEED_TOKEN=
